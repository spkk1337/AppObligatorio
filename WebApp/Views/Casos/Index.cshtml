@using Dominio;
@using Dominio.Entidades
@model Sistema;
@if (Context.Session.GetString("rol") == "Detective" || Context.Session.GetString("rol") == "Fiscal")
{
    <h1>Listado Casos</h1>
    @if (ViewBag.listaCasos != null)
    {
        <ul>
            @foreach (Caso c in ViewBag.listaCasos)
            {
                <li>
                    @c.ToString()
                    @if (Context.Session.GetString("rol") == "Fiscal")
                    {
                        <div>
                            <a asp-controller="Casos" asp-action="Detalles" asp-route-id="@c.Id"
                               class="btn btn-primary btn-sm mt-1">Ver detalles</a>
                        </div>
                    }
                </li>
            }
        </ul>
    }
    else
    {
        <p>No se han encontrado casos disponibles</p>
    }

}
else
{
    <h1>No tienes permisos para ver el listado de casos.</h1>
}
<p>@ViewBag.msg</p>
